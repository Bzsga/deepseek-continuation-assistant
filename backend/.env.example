# This template is not loaded automatically. Set environment variables explicitly.
# Public service uses daily request counts when API_ENABLED and API_KEY are set.
# Currency budgets below only gate the legacy invitation-only mode.
DB_PATH=data/companion.sqlite3
API_ENABLED=false
MOCK_MODE=false
PUBLIC_ENABLED=true
DAILY_LIMIT=50
USER_DAILY_LIMIT=5
# Successful public registrations in total; invitation registrations do not use these places.
# Zero closes public registration. Existing accounts keep access and follow USER_DAILY_LIMIT unless overridden.
PUBLIC_REGISTRATION_LIMIT=20
ADMIN_PASSWORD_HASH=
# Optional operations-only credential. The mobile app uses /v1/admin/login.
ADMIN_TOKEN=
API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
GLOBAL_BUDGET_CNY=0
MONTHLY_BUDGET_CNY=0
USER_BUDGET_CNY=0
PER_JOB_LIMIT_CNY=0
# Optional accounting prices in CNY per million tokens. If either is zero,
# public service still works and reports cost_known=false.
# Legacy invitation-only money budgets require both prices to be configured.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
CONTEXT_TOKENS=32768
MAX_OUTPUT_TOKENS=2048
PROVIDER_TIMEOUT_SECONDS=90
CLEANUP_INTERVAL_SECONDS=30
WORKER_ENABLED=true
# Same-process concurrent model requests, integer 1..5. Keep one Uvicorn process.
WORKER_CONCURRENCY=2
MAX_BODY_BYTES=65536
MAX_RESPONSE_BYTES=65536

# Failed-provider debugging artifacts are private; successful calls are not captured.
FAILURE_ARTIFACTS_ENABLED=true
# 1..168 hours, default 24; expiry blocks access even before the cleanup sweep.
FAILURE_ARTIFACTS_TTL_HOURS=24

# Optional private, service-owned 0600 JSON. Never commit its credential content.
FALLBACK_PROVIDERS_FILE=
